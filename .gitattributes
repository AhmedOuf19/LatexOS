# Normalize line endings so the repo is consistent across Windows/macOS/Linux.
* text=auto eol=lf

# Windows scripts must keep CRLF to run correctly.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets - never touch these.
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ttf binary
*.otf binary
